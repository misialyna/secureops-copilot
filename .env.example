GROQ_API_KEY=
DATABASE_URL=

# Optional — observability (Etap 9). Leave all three empty to disable tracing entirely;
# the app runs fine without them. Get these from your project settings on cloud.langfuse.com
# (EU) or us.cloud.langfuse.com (US) — pick the host matching where you created the account.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
